# Oracle Cloud Infrastructure Configuration
# Copy this file to .env and fill in your credentials

# Tenancy OCID (from Oracle Cloud Console)
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaaaaaa...

# User OCID (from Oracle Cloud Console)
OCI_USER_OCID=ocid1.user.oc1..aaaaaaaa...

# Fingerprint of your API key (from Oracle Cloud Console)
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99

# Path to your private key file
OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem

# Region (e.g., us-phoenix-1, us-ashburn-1, sa-saopaulo-1, etc.)
OCI_REGION=us-phoenix-1

# Compartment OCID (where buckets will be created)
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaaaaaa...

# Namespace (Object Storage namespace - find in Oracle Cloud Console)
OCI_NAMESPACE=your-namespace

# Server port
PORT=3000

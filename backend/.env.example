PORT=3000

# Configuración de Oracle Cloud Infrastructure (OCI)
# Estos valores se configurarán desde la interfaz web

# Ejemplo de valores requeridos:
# OCI_TENANCY=ocid1.tenancy.oc1..example
# OCI_USER=ocid1.user.oc1..example
# OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
# OCI_REGION=us-ashburn-1
# OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example
# OCI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# Oracle Cloud Infrastructure Configuration
# Copy this file to .env and fill in your credentials

# OCI Tenancy OCID
OCI_TENANCY=ocid1.tenancy.oc1..aaaaaaaa...

# OCI User OCID
OCI_USER=ocid1.user.oc1..aaaaaaaa...

# OCI API Key Fingerprint
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99

# OCI Private Key (PEM format - use \n for line breaks or path to file)
OCI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...

# OCI Region (e.g., us-phoenix-1, us-ashburn-1)
OCI_REGION=us-phoenix-1

# OCI Compartment OCID
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaa...

# Server Port
PORT=3001
